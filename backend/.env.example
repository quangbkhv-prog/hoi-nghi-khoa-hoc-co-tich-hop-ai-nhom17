DATABASE_URL=sqlite:///./conference.db
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== AI =====
# Chọn openai hoặc ollama
AI_PROVIDER=openai

# OpenAI Responses API
